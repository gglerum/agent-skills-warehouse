{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "gates"
  ],
  "properties": {
    "current_phase": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "class": {
            "enum": [
              "AUTO",
              "REVIEW",
              "HUMAN"
            ]
          },
          "status": {
            "enum": [
              "queued",
              "active",
              "recommended_pass",
              "passed",
              "blocked",
              "parked"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval": {
            "type": "object",
            "required": [
              "by",
              "gate",
              "record"
            ],
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "gate": {
                "type": "string",
                "minLength": 1
              },
              "record": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
